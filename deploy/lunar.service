[Unit]
Description=Lunar Backend (katalog MovieZone + jalur pemutar HLS)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lunar-server
ExecStart=/usr/bin/node /opt/lunar-server/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=3000

# Jalur pemutar membuka Chromium, jadi batas memori harus cukup untuk Node
# ditambah satu peramban (Chromium butuh sekitar 250-400 MB saat bekerja).
# Batas terlalu kecil membuat server dihentikan sistem tepat saat memuat video.
MemoryMax=1500M
MemoryHigh=1200M

StandardOutput=append:/var/log/lunar.log
StandardError=append:/var/log/lunar.log

[Install]
WantedBy=multi-user.target
